      "mainEntity": [
        {
          "@type": "Question",
          "name": "What details should I share for a fast quotation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Share the product type, brand preference, size or part number, quantity, machine application and delivery location. Photos of existing markings or drawings help our team identify the correct option faster."
          }
        },
        {
          "@type": "Question",
          "name": "Do you supply outside Pune?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. RB International supports customers across India and selected export requirements from our Bhosari, Pune base."
          }
        },
        {
          "@type": "Question",
          "name": "Can you help if I do not know the exact product code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Send the application, current product photo, size, pulley or machine details, and our team will help shortlist suitable belting, automation or adhesive options."
          }
        },
        {
          "@type": "Question",
          "name": "Which product categories can I enquire about?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can enquire for power transmission products, automation and motion control components, industrial adhesives, MRO chemicals and related maintenance requirements."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly will your team respond?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For working-hour enquiries, the team aims to respond quickly by phone, email or WhatsApp after reviewing the requirement details."
          }
